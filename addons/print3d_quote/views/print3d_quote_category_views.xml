<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_print3d_quote_category_tree" model="ir.ui.view">
        <field name="name">print3d.quote.category.tree</field>
        <field name="model">print3d.quote.category</field>
        <field name="arch" type="xml">
            <tree string="Categorías de Cotización">
                <field name="name"/>
                <field name="parent_id"/>
                <field name="quote_count"/>
            </tree>
        </field>
    </record>

    <record id="view_print3d_quote_category_form" model="ir.ui.view">
        <field name="name">print3d.quote.category.form</field>
        <field name="model">print3d.quote.category</field>
        <field name="arch" type="xml">
            <form string="Categoría">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nombre de Categoría"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="parent_id"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Descripción">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_print3d_quote_category" model="ir.actions.act_window">
        <field name="name">Categorías</field>
        <field name="res_model">print3d.quote.category</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
