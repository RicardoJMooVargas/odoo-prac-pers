<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- VISTA FORMULARIO -->
    <record id="view_print3d_quote_form" model="ir.ui.view">
        <field name="name">print3d.quote.form</field>
        <field name="model">print3d.quote</field>
        <field name="arch" type="xml">
            <form string="Cotización 3D">
                <header>
                    <button name="action_confirm" string="Confirmar" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="%(action_print3d_quote_make_sale)d" string="Crear Venta" type="action" class="oe_highlight" invisible="state != 'confirmed' or sale_order_count &gt; 0"/>
                    <button name="action_generate_po" string="Generar Orden de Compra" type="object" invisible="not stock_alert"/>

                    <button name="action_draft" string="Volver a Borrador" type="object" invisible="state == 'draft'"/>
                    <button name="action_cancel" string="Cancelar" type="object" invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,cancelled"/>
                </header>
                <div class="alert alert-warning mb-0" role="alert" invisible="not stock_alert">
                    <i class="fa fa-warning"/> Hay materiales con stock insuficiente para este trabajo.
                </div>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_pickings" type="object" class="oe_stat_button" icon="fa-cubes" invisible="picking_count == 0">
                            <field name="picking_count" widget="statinfo" string="Consumos"/>
                        </button>
                        <button name="action_view_sales" type="object" class="oe_stat_button" icon="fa-usd" invisible="sale_order_count == 0">
                            <field name="sale_order_count" widget="statinfo" string="Ventas"/>
                        </button>
                        <button name="action_view_purchases" type="object" class="oe_stat_button" icon="fa-credit-card" invisible="purchase_count == 0">
                            <field name="purchase_count" widget="statinfo" string="Compras"/>
                        </button>
                    </div>
                    <field name="image" widget="image"/>
                    <div class="oe_title">

                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="description" readonly="state != 'draft'"/>
                            <field name="category_id" readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="stock_alert" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="sale_order_count" invisible="1"/>

                            <field name="electricity_cost_kwh" readonly="state != 'draft'"/>
                        </group>

                    </group>
                    <notebook>
                        <page string="Materiales" name="materials">
                            <field name="material_line_ids" readonly="state != 'draft'">
                                <tree editable="bottom">
                                    <field name="attr_material_type" options="{'no_create': True}"/>
                                    <field name="attr_finish" options="{'no_create': True}"/>
                                    <field name="attr_color" options="{'no_create': True}"/>
                                    <field name="html_color" widget="color" nolabel="1"/>
                                    <field name="filament_id" required="1"/>
                                    <field name="weight_grams"/>
                                    <field name="stock_qty" string="Stock (g)"
                                           decoration-success="stock_qty &gt;= weight_grams" 
                                           decoration-warning="stock_qty &lt; weight_grams and stock_qty &gt; 0" 
                                           decoration-danger="stock_qty &lt;= 0"/>
                                    <field name="price_per_kg"/>

                                    <field name="cost" sum="Total Materiales"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Equipos" name="printers">
                            <field name="printer_line_ids" readonly="state != 'draft'">
                                <tree editable="bottom">
                                    <field name="printer_id"/>
                                    <field name="print_hours" widget="float_time"/>
                                    <field name="power_kw"/>

                                    <field name="depreciation_per_hour"/>
                                    <field name="energy_cost" sum="Total Energía"/>
                                    <field name="wear_cost" sum="Total Desgaste"/>
                                    <field name="total_cost" sum="Total Equipos"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Mano de Obra e Insumos" name="labor_supplies">
                            <group>
                                <group string="Mano de Obra">
                                    <field name="labor_hours" widget="float_time" readonly="state != 'draft'"/>
                                    <field name="labor_cost_per_hour" readonly="state != 'draft'"/>
                                    <field name="cost_labor" readonly="1"/>
                                </group>
                            </group>

                            <separator string="Insumos Adicionales"/>
                            <field name="supply_line_ids" readonly="state != 'draft'">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="subtotal" sum="Total Insumos"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notas" name="notes">
                            <field name="notes" placeholder="Consideraciones para la impresión..."/>
                        </page>
                        <page string="Imágenes Adicionales" name="images">
                            <field name="image_ids">
                                <kanban>
                                    <field name="id"/>
                                    <field name="name"/>
                                    <field name="image"/>
                                    <templates>
                                        <t t-name="kanban-box">
                                            <div class="oe_kanban_global_click text-center">
                                                <div class="o_kanban_image_full_cover">
                                                    <img t-att-src="kanban_image('print3d.quote.image', 'image', record.id.raw_value)" alt="Imagen" style="max-height: 200px; max-width: 100%;"/>
                                                </div>
                                                <div class="oe_kanban_details mt-2">
                                                    <field name="name"/>
                                                </div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                                <form>
                                    <sheet>
                                        <group>
                                            <field name="name"/>
                                            <field name="image" widget="image"/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>

                    <group name="note_group" col="6" class="mt-2 mt-md-0">
                        <group class="oe_subtotal_footer oe_right" colspan="2" name="quote_total">
                            <field name="cost_materials" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="cost_energy" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="cost_wear" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="cost_labor" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="cost_supplies" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <div class="oe_subtotal_footer_separator oe_inline o_td_label">
                                <label for="subtotal_cost"/>
                            </div>
                            <field name="subtotal_cost" nolabel="1" class="oe_subtotal_footer_separator" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="margin" readonly="state != 'draft'"/>
                            <field name="subtotal_with_margin" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="discount" readonly="state != 'draft'"/>
                            <field name="discount_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>

                            <div class="oe_subtotal_footer_separator oe_inline o_td_label">
                                <label for="total"/>
                            </div>
                            <field name="total" nolabel="1" class="oe_subtotal_footer_separator" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- VISTA LISTA -->
    <record id="view_print3d_quote_tree" model="ir.ui.view">
        <field name="name">print3d.quote.tree</field>
        <field name="model">print3d.quote</field>
        <field name="arch" type="xml">
            <tree string="Cotizaciones">
                <field name="name"/>
                <field name="date"/>
                <field name="category_id"/>
                <field name="description"/>
                <field name="total"/>
                <field name="state" widget="badge" 
                       decoration-info="state == 'draft'" 
                       decoration-success="state == 'confirmed'" 
                       decoration-danger="state == 'cancelled'"/>
                <field name="stock_alert" widget="boolean_toggle" readonly="1"/>
                <field name="currency_id" invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- VISTA KANBAN -->
    <record id="view_print3d_quote_kanban" model="ir.ui.view">
        <field name="name">print3d.quote.kanban</field>
        <field name="model">print3d.quote</field>
        <field name="arch" type="xml">
            <kanban default_group_by="category_id" class="o_kanban_mobile">
                <field name="name"/>
                <field name="category_id"/>
                <field name="total"/>
                <field name="currency_id"/>
                <field name="image"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click o_kanban_record_has_image_fill o_print3d_quote_kanban">
                            <div class="o_kanban_image_fill_left d-none d-md-block" t-attf-style="background-image:url('#{kanban_image('print3d.quote', 'image', record.id.raw_value)}')">
                                <img class="o_kanban_image_inner_pic" t-if="record.image.raw_value" t-att-src="kanban_image('print3d.quote', 'image', record.id.raw_value)" alt="Cotización"/>
                            </div>
                            <div class="oe_kanban_details">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title"><field name="name"/></strong>
                                    </div>
                                    <div class="o_dropdown_kanban dropdown">
                                        <a role="button" class="dropdown-toggle o-no-caret btn" data-bs-toggle="dropdown" href="#" aria-label="Dropdown menu" title="Dropdown menu">
                                            <span class="fa fa-ellipsis-v"/>
                                        </a>
                                        <div class="dropdown-menu" role="menu">
                                            <a role="menuitem" type="edit" class="dropdown-item">Editar</a>
                                            <a role="menuitem" type="delete" class="dropdown-item">Eliminar</a>
                                        </div>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div><field name="description"/></div>
                                    <div><strong>Total: </strong><field name="total" widget="monetary" options="{'currency_field': 'currency_id'}"/></div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="state" widget="label_selection" options="{'classes': {'draft': 'default', 'confirmed': 'success', 'cancelled': 'danger'}}"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_print3d_quote" model="ir.actions.act_window">
        <field name="name">Cotizaciones 3D</field>
        <field name="res_model">print3d.quote</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea tu primera cotización de impresión 3D
            </p>
        </field>
    </record>
</odoo>
