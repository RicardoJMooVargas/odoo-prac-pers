<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_print3d" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.print3d</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <!-- Como usamos un transient model propio (print3d.config),
                     lo mostramos como una vista de formulario normal para ajustes. -->
            </xpath>
        </field>
    </record>

    <!-- Vista Formulario para print3d.config (Ajustes de Impresión 3D) -->
    <record id="view_print3d_config_form" model="ir.ui.view">
        <field name="name">print3d.config.form</field>
        <field name="model">print3d.config</field>
        <field name="arch" type="xml">
            <form string="Ajustes de Impresión 3D" class="oe_form_configuration">
                <header>
                    <button string="Guardar" type="object" name="set_values" class="oe_highlight"/>
                    <button string="Descartar" type="object" name="cancel" special="cancel"/>
                </header>
                <sheet>
                    <h2>Ajustes Globales de Cotización</h2>
                    <group>
                        <group>
                            <field name="electricity_cost_kwh"/>
                            <field name="labor_cost_per_hour"/>
                            <field name="default_margin"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_print3d_config" model="ir.actions.act_window">
        <field name="name">Ajustes</field>
        <field name="res_model">print3d.config</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
    </record>
</odoo>
