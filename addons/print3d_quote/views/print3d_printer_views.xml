<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_print3d_printer_tree" model="ir.ui.view">
        <field name="name">print3d.printer.tree</field>
        <field name="model">print3d.printer</field>
        <field name="arch" type="xml">
            <tree string="Impresoras">
                <field name="name"/>
                <field name="purchase_price"/>
                <field name="power_consumption_kw"/>
                <field name="lifespan_hours"/>
                <field name="depreciation_per_hour"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_print3d_printer_form" model="ir.ui.view">
        <field name="name">print3d.printer.form</field>
        <field name="model">print3d.printer</field>
        <field name="arch" type="xml">
            <form string="Impresora">
                <sheet>
                    <widget name="web_ribbon" title="Archivada" bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Ej. Bambu Lab X1C"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="purchase_price"/>
                            <field name="power_consumption_kw"/>
                        </group>
                        <group>
                            <field name="lifespan_hours"/>
                            <field name="depreciation_per_hour"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notas">
                            <field name="notes" placeholder="Información técnica, mantenimientos..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_print3d_printer" model="ir.actions.act_window">
        <field name="name">Impresoras</field>
        <field name="res_model">print3d.printer</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea tu primera Impresora 3D
            </p>
        </field>
    </record>
</odoo>
