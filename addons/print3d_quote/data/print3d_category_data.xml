<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Categorías Raíz -->
        <record id="quote_cat_figuras" model="print3d.quote.category">
            <field name="name">Figuras</field>
            <field name="color">1</field>
        </record>
        <record id="quote_cat_utilidad" model="print3d.quote.category">
            <field name="name">Utilidad</field>
            <field name="color">2</field>
        </record>
        <record id="quote_cat_repuestos" model="print3d.quote.category">
            <field name="name">Repuestos</field>
            <field name="color">3</field>
        </record>

        <!-- Subcategorías -->
        <record id="quote_cat_figuras_anime" model="print3d.quote.category">
            <field name="name">Anime</field>
            <field name="parent_id" ref="quote_cat_figuras"/>
        </record>
        <record id="quote_cat_utilidad_bano" model="print3d.quote.category">
            <field name="name">Baño</field>
            <field name="parent_id" ref="quote_cat_utilidad"/>
        </record>
        <record id="quote_cat_utilidad_cocina" model="print3d.quote.category">
            <field name="name">Cocina</field>
            <field name="parent_id" ref="quote_cat_utilidad"/>
        </record>
    </data>
</odoo>
