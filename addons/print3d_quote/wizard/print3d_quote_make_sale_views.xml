<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_print3d_quote_make_sale_form" model="ir.ui.view">
        <field name="name">print3d.quote.make.sale.form</field>
        <field name="model">print3d.quote.make.sale</field>
        <field name="arch" type="xml">
            <form string="Crear Venta">
                <p class="text-muted">
                    Selecciona el cliente al que se le facturará este trabajo de impresión 3D.
                </p>
                <group>
                    <field name="partner_id" widget="res_partner_many2one" context="{'res_partner_search_mode': 'customer'}"/>
                </group>
                <footer>
                    <button name="action_create_sale_order" string="Crear Venta" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_print3d_quote_make_sale" model="ir.actions.act_window">
        <field name="name">Crear Orden de Venta</field>
        <field name="res_model">print3d.quote.make.sale</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
